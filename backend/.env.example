# Copy this file to .env and adjust values. Never commit .env.
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---------- Storage ----------
# Folder where Excel workbooks are stored. In production this MUST be a
# persistent disk (not an ephemeral/serverless filesystem).
DATA_DIR=./data

# ---------- Authentication ----------
# Long random secret used to sign JWTs (min 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Owner account, used ONLY on first start when no user exists yet.
# The password is hashed with bcrypt and saved to users.xlsx; after the first
# start you should remove OWNER_PASSWORD from this file.
OWNER_NAME=Business Owner
OWNER_EMAIL=agnisetufiresafety@gmail.com
OWNER_PASSWORD=

# ---------- Business (printed on quotations / invoices) ----------
# Your GSTIN. Leave empty if not GST-registered (issue Non-GST invoices only).
BUSINESS_GSTIN=
# State used for Place of Supply and CGST/SGST vs IGST. 24 = Gujarat.
BUSINESS_STATE_CODE=24
BUSINESS_STATE_NAME=Gujarat

# ---------- Google Sheets (optional) ----------
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account JSON key, relative to backend/. Keep it in backend/credentials/ (git-ignored).
# Share the spreadsheet with the key's client_email.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json

# ---------- Backups ----------
# Folder for automatic snapshots taken before every restore (git-ignored).
BACKUP_DIR=./backups

# ---------- Users ----------
# Maximum number of admin accounts (Settings > Users).
MAX_ADMINS=2
# Optional: tab names (defaults "Customers" and "Users"). Useful for testing on separate tabs.
# GOOGLE_SHEETS_CUSTOMERS_TAB=Customers
# GOOGLE_SHEETS_USERS_TAB=Users
