# Frontend env vars are PUBLIC (bundled into the browser). Never put secrets here.

# Base URL of the backend API. Leave empty in development (Vite proxies /api).
# In production set to the deployed backend, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev-only: where Vite proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:5000
